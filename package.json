{
  "name": "landisk",
  "version": "1.0.0",
  "description": "LanDisk - 内网文件服务器",
  "main": "server.js",
  "scripts": {
    "start": "npx tauri dev",
    "server": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/logs.test.js",
    "build": "cd client && npm run build",
    "build:server": "npm --prefix client run build && node scripts/bundle-server.js",
    "prebuild": "npm run build:server",
    "tauri": "npx tauri"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.3.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "archiver": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "to-ico": "^1.1.5"
  }
}
