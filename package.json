{
  "name": "landisk",
  "version": "0.1.2",
  "description": "LanDisk - 内网文件服务器",
  "scripts": {
    "start": "npx tauri dev",
    "server": "cargo run --manifest-path src-tauri/server/Cargo.toml -- --static-dir=client/dist",
    "dev": "cargo watch --poll --watch src --workdir src-tauri/server -x \"run -- --static-dir=../../client/dist\"",
    "build": "cd client && npm run build",
    "build:server": "npm --prefix client run build && node scripts/build-sidecar.js",
    "build:sidecar": "node scripts/build-sidecar.js",
    "prebuild": "npm run build:server",
    "tauri": "npx tauri",
    "build:tauri": "npm run build:server && npx tauri build && node scripts/copy-installer.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "ws": "^8.21.1"
  }
}
