{
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/landisk-server",
          "cmd": "",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
